{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog",
    "products"
  ],
  "properties": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailer",
        "campaign_name",
        "valid_from",
        "valid_until",
        "source_page"
      ],
      "properties": {
        "retailer": {
          "type": [
            "string",
            "null"
          ]
        },
        "campaign_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_name",
          "brand",
          "category",
          "variant",
          "quantity",
          "price",
          "campaign",
          "installment",
          "attributes",
          "confidence",
          "needs_review",
          "uncertainty_reason"
        ],
        "properties": {
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "variant": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit",
                  "package_count",
                  "raw_text"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "package_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "raw_text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "previous",
              "currency",
              "price_type"
            ],
            "properties": {
              "current": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "previous": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "currency": {
                "type": "string",
                "const": "TRY"
              },
              "price_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "campaign": {
            "type": [
              "string",
              "null"
            ]
          },
          "installment": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "description"
                ],
                "properties": {
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_review": {
            "type": "boolean"
          },
          "uncertainty_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
