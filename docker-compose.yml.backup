services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: akilli_alisveris
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d akilli_alisveris"]
      interval: 5s
      timeout: 5s
      retries: 10
    ports:
      - "5432:5432"
    volumes:
      - poc_postgres_data:/var/lib/postgresql/data

volumes:
  poc_postgres_data:
