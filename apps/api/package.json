{
  "name": "@akilli-alisveris/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require(\u0027node:fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})\"",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile .turbo/typecheck.tsbuildinfo"
  },
  "dependencies": {
    "@akilli-alisveris/config": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}
